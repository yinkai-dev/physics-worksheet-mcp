{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:physics-latex-export:answer-package-v1",
  "title": "answer-package-v1 package.json",
  "description": "Immutable package. answers.jsonl validates each line against #/$defs/answer; asset-manifest.jsonl uses #/$defs/asset. SHA256SUMS lists package.json, both JSONL files and every assets/<sha256>.png as lowercase SHA256, two spaces, POSIX path. hashes.assets_sha256 is the SHA256 of the sorted asset IDs, one JSON string per line with a final LF (a single LF for the empty set). Directory name equals answer_package_id. Cross-file, provider and asset limits are checked by the loader.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "answer_package_id",
    "kb_name",
    "provider",
    "answer_documents",
    "adapter",
    "hashes",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": "answer-1.0"
    },
    "answer_package_id": {
      "$ref": "#/$defs/id"
    },
    "kb_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "revision_id",
        "provider_fingerprint",
        "adapter_kind"
      ],
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/id"
        },
        "revision_id": {
          "$ref": "#/$defs/id"
        },
        "provider_fingerprint": {
          "$ref": "#/$defs/hash"
        },
        "adapter_kind": {
          "const": "question-package-v1"
        }
      }
    },
    "answer_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/answer_document"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "created_at"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answers_sha256",
        "asset_manifest_sha256",
        "assets_sha256"
      ],
      "properties": {
        "answers_sha256": {
          "$ref": "#/$defs/hash"
        },
        "asset_manifest_sha256": {
          "$ref": "#/$defs/hash"
        },
        "assets_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "PDF page coordinates [x0,y0,x1,y1], in points, top-left origin."
    },
    "answer_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_document_id",
        "document_id",
        "identifier",
        "sha256",
        "pages"
      ],
      "properties": {
        "answer_document_id": {
          "$ref": "#/$defs/id"
        },
        "document_id": {
          "$ref": "#/$defs/id"
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "pages": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "math"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "score"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "asset_id"
          ],
          "properties": {
            "type": {
              "const": "figure"
            },
            "asset_id": {
              "$ref": "#/$defs/hash"
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        }
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question_sha256",
        "document_id",
        "original_question_number",
        "status",
        "key",
        "body",
        "source_pages",
        "source_bboxes",
        "review"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/id"
        },
        "question_sha256": {
          "$ref": "#/$defs/hash"
        },
        "document_id": {
          "$ref": "#/$defs/id"
        },
        "original_question_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "enum": [
            "source",
            "missing"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{1,26}$",
          "description": "Unique, ascending letters from the provider's effective choice options. Null for non-choice, missing, or a choice with an explanation and no valid key."
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "maxItems": 200
        },
        "source_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_bboxes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page",
              "bbox"
            ],
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "bbox": {
                "$ref": "#/$defs/bbox"
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewed_at",
            "reviewed_by",
            "basis",
            "pixel_evidence"
          ],
          "properties": {
            "reviewed_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "reviewed_by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "basis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "转录核验，不代表物理正确性"
            },
            "pixel_evidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "missing_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "missing"
              }
            }
          },
          "then": {
            "required": [
              "missing_reason"
            ],
            "properties": {
              "key": {
                "const": null
              },
              "body": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "missing_reason"
              ]
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "path",
        "media_type",
        "width",
        "height",
        "bytes",
        "question_id",
        "role",
        "required",
        "order",
        "placement",
        "source_document_id",
        "source_page",
        "source_bbox",
        "source_document_sha256",
        "input_sha256",
        "runtime_sha256",
        "review_status",
        "review_basis"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/hash"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[a-f0-9]{64}\\.png$"
        },
        "media_type": {
          "const": "image/png"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "question_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "const": "answer_figure"
        },
        "required": {
          "const": true
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "placement": {
          "enum": [
            "in_content",
            "after_body"
          ]
        },
        "source_document_id": {
          "$ref": "#/$defs/id"
        },
        "source_page": {
          "type": "integer",
          "minimum": 1
        },
        "source_bbox": {
          "$ref": "#/$defs/bbox"
        },
        "source_document_sha256": {
          "$ref": "#/$defs/hash"
        },
        "input_sha256": {
          "$ref": "#/$defs/hash"
        },
        "runtime_sha256": {
          "$ref": "#/$defs/hash"
        },
        "review_status": {
          "const": "approved"
        },
        "review_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "width_mm": {
          "type": "number",
          "minimum": 5,
          "maximum": 170
        }
      },
      "description": "source_document_id is the answer_document_id. order is the 1-based sequence of figure blocks. width_mm is optional for in_content.",
      "allOf": [
        {
          "if": {
            "properties": {
              "placement": {
                "const": "after_body"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "width_mm"
              ]
            }
          }
        }
      ]
    }
  }
}