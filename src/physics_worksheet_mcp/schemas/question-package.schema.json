{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:physics-latex-export:question-package-v1",
  "title": "question-package-v1 package.json",
  "description": "The complete package also requires documents/*.md, questions.jsonl, asset-manifest.jsonl, assets/* and SHA256SUMS; cross-file rules are enforced by VerifiedQuestionStore.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "package_id", "kb_name", "source_type", "documents", "adapter", "hashes", "scope"],
  "properties": {
    "schema_version": {"const": "1.0"}, "package_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "kb_name": {"type": "string", "minLength": 1, "maxLength": 300}, "source_type": {"enum": ["pdf-derived", "structured_bundle"]},
    "documents": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/document"}},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["name", "version", "created_at"], "properties": {
      "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1}
    }},
    "hashes": {"type": "object", "additionalProperties": false, "required": ["questions_sha256", "asset_manifest_sha256", "assets_sha256"], "properties": {
      "questions_sha256": {"$ref": "#/$defs/hash"}, "asset_manifest_sha256": {"$ref": "#/$defs/hash"}, "assets_sha256": {"$ref": "#/$defs/hash"}
    }},
    "scope": {"type": "string", "minLength": 1, "maxLength": 2000}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "document": {"type": "object", "additionalProperties": false, "required": ["document_id", "title", "content_sha256", "source_document"], "properties": {
      "document_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 500},
      "content_sha256": {"$ref": "#/$defs/hash"}, "source_document": {"type": "object", "additionalProperties": false, "required": ["identifier", "sha256", "pages"], "properties": {
        "identifier": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "pages": {"type": "integer", "minimum": 1}
      }}
    }}
  }
}
