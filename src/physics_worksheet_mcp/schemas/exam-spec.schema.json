{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:physics-latex-export:exam-spec:1.3",
  "title": "ExamSpec 1.0, 1.1, 1.2 and 1.3",
  "description": "Structural schema. Runtime additionally verifies hashes, math safety, asset bytes and cross-record relations.",
  "oneOf": [
    {
      "$ref": "#/$defs/spec10"
    },
    {
      "$ref": "#/$defs/spec11"
    },
    {
      "$ref": "#/$defs/spec12"
    },
    {
      "$ref": "#/$defs/spec13"
    }
  ],
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "maxLength": 300,
          "default": ""
        },
        "include_answers": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "math"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          }
        }
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "maybeEmptyBlocks": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "choices": {
      "type": "array",
      "maxItems": 10,
      "default": [],
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          {
            "$ref": "#/$defs/blocks"
          }
        ]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kb_name",
        "title",
        "chunk_id",
        "source_excerpt",
        "content_sha256"
      ],
      "properties": {
        "kb_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100000,
          "default": null
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "default": null
        },
        "source_excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30000
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "body"
          ],
          "properties": {
            "origin": {
              "const": "model"
            },
            "body": {
              "$ref": "#/$defs/blocks"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "body",
            "source"
          ],
          "properties": {
            "origin": {
              "const": "source"
            },
            "body": {
              "$ref": "#/$defs/blocks"
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "role",
        "required",
        "order",
        "placement"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "role": {
          "enum": [
            "question_figure",
            "shared_figure",
            "full_question_facsimile"
          ]
        },
        "required": {
          "const": true
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "placement": {
          "enum": [
            "after_stem",
            "replace_question"
          ]
        }
      }
    },
    "question10": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "body",
        "source",
        "review_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "body": {
          "$ref": "#/$defs/blocks"
        },
        "choices": {
          "$ref": "#/$defs/choices"
        },
        "choice_mode": {
          "enum": [
            "single",
            "multiple",
            "unspecified"
          ],
          "default": "unspecified"
        },
        "points": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000,
          "default": null
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "review_status": {
          "const": "retrieved-complete"
        },
        "answer": {
          "$ref": "#/$defs/answer"
        }
      }
    },
    "question11": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "body",
        "source",
        "review_status",
        "representation",
        "original_number",
        "assets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "body": {
          "$ref": "#/$defs/maybeEmptyBlocks"
        },
        "choices": {
          "$ref": "#/$defs/choices"
        },
        "choice_mode": {
          "enum": [
            "single",
            "multiple",
            "unspecified"
          ],
          "default": "unspecified"
        },
        "points": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000,
          "default": null
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "review_status": {
          "const": "retrieved-complete"
        },
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "representation": {
          "enum": [
            "structured",
            "facsimile"
          ]
        },
        "original_number": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,3}$"
        },
        "assets": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/asset"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": {
                "const": "structured"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "representation": {
                "const": "facsimile"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "maxItems": 0
              },
              "choices": {
                "maxItems": 0
              },
              "assets": {
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/asset"
                    },
                    {
                      "properties": {
                        "role": {
                          "const": "full_question_facsimile"
                        },
                        "placement": {
                          "const": "replace_question"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "spec10": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document",
        "questions"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "document": {
          "$ref": "#/$defs/document"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/question10"
          }
        }
      }
    },
    "spec11": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document",
        "questions"
      ],
      "properties": {
        "schema_version": {
          "const": "1.1"
        },
        "document": {
          "$ref": "#/$defs/document"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/question11"
          }
        }
      }
    },
    "richBlock": {
      "oneOf": [
        {
          "$ref": "#/$defs/block"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "asset_id"
          ],
          "properties": {
            "type": {
              "const": "figure"
            },
            "asset_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "caption": {
              "$ref": "#/$defs/maybeEmptyBlocks"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "$ref": "#/$defs/maybeEmptyBlocks"
                }
              }
            }
          }
        }
      ]
    },
    "richBlocks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 400,
      "items": {
        "$ref": "#/$defs/richBlock"
      }
    },
    "richChoices": {
      "type": "array",
      "maxItems": 10,
      "default": [],
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          {
            "$ref": "#/$defs/richBlocks"
          }
        ]
      }
    },
    "asset12": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "role",
        "required",
        "order",
        "placement"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "role": {
          "enum": [
            "question_figure",
            "shared_figure",
            "full_question_facsimile"
          ]
        },
        "required": {
          "const": true
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "placement": {
          "enum": [
            "after_stem",
            "replace_question",
            "in_content"
          ]
        },
        "width_mm": {
          "type": "number",
          "minimum": 5,
          "maximum": 170
        },
        "source_layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page_size_pt",
            "bbox_pt",
            "alignment",
            "row_group",
            "gap_before_mm",
            "anchor",
            "basis"
          ],
          "properties": {
            "page_size_pt": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "bbox_pt": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "alignment": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "row_group": {
              "type": "string"
            },
            "gap_before_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 25
            },
            "anchor": {
              "type": "string"
            },
            "basis": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "placement": {
                "const": "in_content"
              }
            }
          },
          "then": {
            "required": [
              "width_mm"
            ]
          }
        }
      ]
    },
    "question12": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "body",
        "source",
        "review_status",
        "representation",
        "original_number",
        "assets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "body": {
          "$ref": "#/$defs/richBlocks"
        },
        "choices": {
          "$ref": "#/$defs/richChoices"
        },
        "choice_mode": {
          "enum": [
            "single",
            "multiple",
            "unspecified"
          ],
          "default": "unspecified"
        },
        "points": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000,
          "default": null
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "review_status": {
          "const": "retrieved-complete"
        },
        "answer": true,
        "representation": {
          "enum": [
            "structured",
            "facsimile"
          ]
        },
        "original_number": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,3}$"
        },
        "assets": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/asset12"
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "start_block",
            "right_asset_ids",
            "gap_mm"
          ],
          "properties": {
            "mode": {
              "const": "right_panel"
            },
            "start_block": {
              "type": "integer",
              "minimum": 0
            },
            "right_asset_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "gap_mm": {
              "type": "number",
              "minimum": 2,
              "maximum": 12
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "representation": {
                "const": "structured"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "representation": {
                "const": "facsimile"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "maxItems": 0
              },
              "choices": {
                "maxItems": 0
              },
              "assets": {
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/asset"
                    },
                    {
                      "properties": {
                        "role": {
                          "const": "full_question_facsimile"
                        },
                        "placement": {
                          "const": "replace_question"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "spec12": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document",
        "questions"
      ],
      "properties": {
        "schema_version": {
          "const": "1.2"
        },
        "document": {
          "$ref": "#/$defs/document"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/question12"
              },
              {
                "properties": {
                  "answer": {
                    "$ref": "#/$defs/answer"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "answer13": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "key",
        "body",
        "assets"
      ],
      "properties": {
        "origin": {
          "const": "source"
        },
        "key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{1,10}$"
        },
        "body": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/block"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "value"
                ],
                "properties": {
                  "type": {
                    "const": "score"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "asset_id"
                ],
                "properties": {
                  "type": {
                    "const": "figure"
                  },
                  "asset_id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  }
                }
              }
            ]
          }
        },
        "assets": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "role",
              "required",
              "order",
              "placement",
              "width_mm"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "role": {
                "const": "answer_figure"
              },
              "required": {
                "const": true
              },
              "order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "placement": {
                "const": "in_content"
              },
              "width_mm": {
                "type": "number",
                "minimum": 5,
                "maximum": 170
              }
            }
          }
        }
      }
    },
    "spec13": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document",
        "questions"
      ],
      "properties": {
        "schema_version": {
          "const": "1.3"
        },
        "document": {
          "$ref": "#/$defs/document"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/question12"
              },
              {
                "properties": {
                  "answer": {
                    "$ref": "#/$defs/answer13"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
